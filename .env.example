# Current settings read by constants.py. Copy to .env and replace placeholders.
# Required at import time:
OPENAI_API_KEY=replace-with-your-openai-api-key
SYSTEM_PROMPT="Use the configured business knowledge and offer human follow-up."
SENDER_EMAIL_ADDRESS=sender@example.invalid
SENDER_EMAIL_PASS=replace-with-your-smtp-password
RECEIVER_EMAIL_ADDRESS=recipient@example.invalid

# Optional settings; values below match the code defaults.
DATABASE_DNS=sqlite:///database/database.db
SMTP_SERVER=smtp.gmail.com
SMTP_SERVER_PORT=587
LOGGING_LEVEL=INFO
POLLING_INTERVAL=10
BREAK_TIME=3
DELAY=0.5

# Channel credentials and account-specific prompts are stored in SQLite.
# CHATGPT_VERSION is hardcoded in constants.py; no model environment key exists.
